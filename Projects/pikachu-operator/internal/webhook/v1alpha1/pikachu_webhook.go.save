// nolint:unused
// log is for logging in this package.
var pikachulog = logf.Log.WithName("pikachu-resource")

// SetupPikachuWebhookWithManager registers the webhook for Pikachu in the manager.
func SetupPikachuWebhookWithManager(mgr ctrl.Manager) error {
	return ctrl.NewWebhookManagedBy(mgr, &corev1alpha1.Pikachu{}).
		WithValidator(&PikachuCustomValidator{}).
		Complete()
}

